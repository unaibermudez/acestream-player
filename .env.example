# Copia este archivo a .env y ajústalo. .env no se versiona.

# Puerto del equipo en el que se publica la app (nginx).
WEB_PORT=8080

# Descomenta para usar el motor de Acestream instalado en el propio equipo (Ace Stream para
# Windows) en lugar del contenedor, con Docker Desktop. En Windows el separador es ";"; en macOS, ":".
# COMPOSE_FILE=docker-compose.yml;docker-compose.native.yml
