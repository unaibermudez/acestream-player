# Copia este archivo a .env y ajústalo. .env no se versiona.

# Puerto del equipo en el que se publica la app (nginx).
WEB_PORT=8080

# Para usar el motor de Ace Stream instalado en el propio equipo (Docker Desktop) en lugar del
# contenedor, descomenta la línea siguiente. En Windows, windows\iniciar.cmd lo decide solo.
# En Windows el separador es ";"; en macOS, ":".
# COMPOSE_FILE=docker-compose.yml;docker-compose.native.yml
