# Sirve la SPA y hace de proxy inverso hacia el motor de Acestream, todo en el mismo origen.
# Así el navegador nunca habla directamente con el puerto 6878 (sin CORS ni mixed content).
#
# Es una plantilla: al arrancar, la imagen oficial de nginx sustituye las variables ACE_* (ver
# NGINX_ENVSUBST_FILTER en el Dockerfile) y la copia a conf.d/default.conf.

server {
    listen 80;
    listen [::]:80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # DNS interno de Docker. Con proxy_pass a una variable, nginx resuelve el motor en cada
    # petición: arranca aunque el motor aún no exista y sigue funcionando si se recrea con otra IP.
    # ACE_ENGINE es http://acestream:6878 (motor en Docker) o http://host.docker.internal:6878
    # (motor instalado en el propio equipo, ver docker-compose.native.yml).
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $ace_engine ${ACE_ENGINE};

    # ---------- Motor de Acestream ----------

    # Opciones comunes de proxy para el motor.
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # El motor tarda en responder mientras busca peers y precarga; los streams duran horas.
    proxy_connect_timeout 10s;
    proxy_send_timeout 3600s;
    proxy_read_timeout 3600s;

    # Playlists HLS: se reescriben a rutas relativas las URLs absolutas que pueda generar el motor,
    # para que segmentos y recargas pasen siempre por este proxy (y por HTTPS si lo hay delante).
    location ~ ^/ace/.*\.m3u8$ {
        proxy_pass $ace_engine;
        proxy_buffering off;
        # Definir un proxy_set_header aquí anula TODOS los heredados del server: se repiten.
        proxy_set_header Connection "";
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # sub_filter necesita la respuesta sin comprimir.
        proxy_set_header Accept-Encoding "";

        sub_filter_types *;
        sub_filter_once off;
        sub_filter "http://$http_host/" "/";
        sub_filter "http://$host:6878/" "/";
        sub_filter "http://127.0.0.1:6878/" "/";
        sub_filter "http://localhost:6878/" "/";
        sub_filter "http://acestream:6878/" "/";
        sub_filter "http://host.docker.internal:6878/" "/";

        add_header Cache-Control "no-store" always;
    }

    # Segmentos HLS y MPEG-TS directo (getstream): streaming sin buffering.
    location /ace/ {
        proxy_pass $ace_engine;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_cache off;
        add_header X-Accel-Buffering "no" always;
    }

    # Solo el endpoint de la API que usa la app (versión del motor para el indicador de estado).
    location = /webui/api/service {
        proxy_pass $ace_engine;
        proxy_read_timeout 10s;
        add_header Cache-Control "no-store" always;
    }

    # ---------- Datos del servidor (carpeta ./data montada) ----------

    # Catálogo de canales. Sin caché para que sustituir el archivo se vea al recargar, y 404
    # real si falta (no debe caer en el fallback de la SPA).
    location /data/ {
        add_header Cache-Control "no-cache" always;
        try_files $uri =404;
    }

    # ---------- SPA ----------

    # Toda ruta de la SPA acaba aquí vía try_files. add_header en un location anula los del
    # server, así que las cabeceras de seguridad van en este bloque.
    location = /index.html {
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "same-origin" always;
    }

    location = /manifest.webmanifest {
        default_type application/manifest+json;
        add_header Cache-Control "no-cache" always;
    }

    # Los assets de Vite llevan hash en el nombre: se pueden cachear para siempre.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    gzip on;
    gzip_types text/css application/javascript application/json application/manifest+json image/svg+xml;
    gzip_min_length 1024;
}
